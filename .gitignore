# virtual environments
venv/
.venv/
env/

# python caches
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# notebooks checkpoints
.ipynb_checkpoints/

# editors and OS
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# runtime outputs (regenerated by running the scripts)
results/*
!results/.gitkeep
figure_data/*
!figure_data/.gitkeep
figures/*
!figures/.gitkeep
validation/*
!validation/.gitkeep

# temporary files produced while running the figure scripts
figure_data/*.tmp

# Office lock files
~$*.docx
~$*.xlsx
